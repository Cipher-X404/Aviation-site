# Server-side only. Never expose this with a VITE_ prefix or commit a real key.
# Configure it in the deployment's secret manager to enable Gemini itinerary planning and assistants.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Required to enable administrator sign-in. Use a long, random secret stored only on the server.
# Without this value, the admin dashboard stays locked.
ADMIN_ACCESS_CODE=""
